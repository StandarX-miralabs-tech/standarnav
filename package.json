{
  "name": "@standarx/nav",
  "version": "0.2.0",
  "description": "Spatial navigation for the web: d-pad, gamepad sticks, TV remotes and arrow keys drive real DOM focus, declared in data attributes.",
  "keywords": [
    "spatial-navigation",
    "focus",
    "gamepad",
    "d-pad",
    "tv",
    "webos",
    "tizen",
    "keyboard-navigation",
    "accessibility",
    "headless"
  ],
  "license": "MIT",
  "author": "Wesley Cormier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StandarX-miralabs-tech/standarnav.git"
  },
  "homepage": "https://github.com/StandarX-miralabs-tech/standarnav#readme",
  "bugs": "https://github.com/StandarX-miralabs-tech/standarnav/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./angular": "./dist/angular/angular.js",
    "./auto": "./dist/auto/auto.js",
    "./debug": "./dist/debug.js",
    "./focus-ring": "./dist/focus-ring/focus-ring.js",
    "./gamepad": "./dist/gamepad/gamepad.js",
    "./keyboard": "./dist/keyboard/keyboard.js",
    "./keyboard/alphabetic": "./dist/keyboard/layouts/alphabetic.js",
    "./keyboard/azerty": "./dist/keyboard/layouts/azerty.js",
    "./keyboard/qwerty": "./dist/keyboard/layouts/qwerty.js",
    "./react": "./dist/react/react.js",
    "./spatial": "./dist/spatial/spatial.js",
    "./svelte": "./dist/svelte/svelte.js",
    "./vue": "./dist/vue/vue.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite playground --open",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "check:size": "bun run scripts/size-budget.ts",
    "check:package": "bun run scripts/check-package.ts",
    "check:docs": "bun run scripts/check-citations.ts"
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.1",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  }
}
